# Development image running the Vite dev server with HMR.
# Not used for production — see Dockerfile for the production build.
FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Source is bind-mounted at runtime (see docker-compose.dev.yml).

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
