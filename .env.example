# ==============================================================================
# Careflow Project Environment Variables Template (.env.example)
# Copy this file to .env and fill in your confidential credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# Backend Port (Default: 8080)
PORT=8080

# Environment Mode: development / production
APP_ENV=development

# Optional AI Key for Hybrid Micro-Task Slicer (Gemini API)
# Get your Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api


# PostgreSQL primary storage (backend)
DATABASE_URL=postgres://careflow:change_me_before_production@localhost:5432/careflow?sslmode=disable
