# Copy this file to .env.prod and fill in real values before deploying.
# Never commit .env.prod (it contains secrets).

# PostgreSQL password used by both the postgres and backend services.
# Generate a strong random value, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=change_me_before_production

# Public origin of the deployed frontend (protocol + domain/IP, no trailing slash).
# The backend uses this for CORS - it must match exactly what users type in
# their browser, or the browser will block API requests.
# Examples: https://careflow.example.com  or  http://203.0.113.10:5173
FRONTEND_ORIGIN=http://your-vm-ip-or-domain:5173

# Public base URL of the backend API, as seen by the browser (not the internal
# Docker network address). Vite bakes this into the frontend build, so it must
# be set correctly BEFORE building the frontend image.
# Example: https://careflow.example.com:8000/api  or  http://203.0.113.10:8000/api
VITE_API_BASE_URL=http://your-vm-ip-or-domain:8000/api

# Optional: change the demo account password from the default.
DEMO_PASSWORD=CareflowDemo2026!

# Optional: Gemini API key for the AI micro-task slicer. Leave empty to use
# the offline heuristic engine.
GEMINI_API_KEY=

# Optional: host port the frontend container listens on (defaults to 5173).
FRONTEND_PORT=5173

# SECURITY NOTE: docker-compose.prod.yml exposes PostgreSQL on port 5432 for
# convenience (e.g. running `go run ./cmd/seed-demo` from your own machine).
# For a real production deployment, remove the postgres "ports" mapping
# entirely (or restrict it with a firewall) so the database is only reachable
# from the backend container on the internal Docker network. Use an SSH
# tunnel if you need occasional direct access instead of leaving it public.
