# Careflow backend
PORT=8080
APP_ENV=development

# Origin frontend yang diizinkan untuk API Bearer-token.
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL utama. Bila kosong, Careflow menggunakan fallback DATA_FILE lokal.
# Contoh: postgres://careflow:change_me@localhost:5432/careflow?sslmode=disable
DATABASE_URL=

# Fallback lokal untuk demo/offline tanpa PostgreSQL.
DATA_FILE=data/careflow.json

# Akun ini dibuat otomatis bila belum ada saat server dinyalakan.
DEMO_NAME=Careflow Demo
DEMO_EMAIL=demo@careflow.local
DEMO_PASSWORD=CareflowDemo2026!

# Opsional: AI micro-task slicer. Jika kosong, heuristic offline selalu digunakan.
GEMINI_API_KEY=your_gemini_api_key_here
