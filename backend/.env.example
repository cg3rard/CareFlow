# Careflow backend
PORT=8080
APP_ENV=development

# Frontend origin allowed for the Bearer-token API.
FRONTEND_ORIGIN=http://localhost:5173

# Main PostgreSQL connection. If empty, Careflow falls back to the local DATA_FILE.
# Example: postgres://careflow:change_me@localhost:5432/careflow?sslmode=disable
DATABASE_URL=

# Local fallback for demo/offline use without PostgreSQL.
DATA_FILE=data/careflow.json

# This account is created automatically if it doesn't exist when the server starts.
DEMO_NAME=Careflow Demo
DEMO_EMAIL=demo@careflow.local
DEMO_PASSWORD=CareflowDemo2026!

# Optional: AI micro-task slicer. If empty, the offline heuristic is always used.
GEMINI_API_KEY=your_gemini_api_key_here
